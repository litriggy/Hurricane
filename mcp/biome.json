{
  "$schema": "https://biomejs.dev/schemas/2.4.8/schema.json",
  "files": { "includes": ["**", "!pnpm-lock.yaml"] },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noDefaultExport": "error",
        "useImportType": "error",
        "noNonNullAssertion": "error"
      }
    }
  }
}
